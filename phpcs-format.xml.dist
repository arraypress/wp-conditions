<?xml version="1.0"?>
<ruleset name="wordpress-formatting">
    <description>WordPress formatting, minus the rules that fight this codebase.</description>

    <config name="installed_paths" value="vendor/wp-coding-standards/wpcs,vendor/phpcompatibility/php-compatibility,vendor/phpcompatibility/phpcompatibility-paragonie,vendor/phpcompatibility/phpcompatibility-wp,vendor/phpcsstandards/phpcsutils,vendor/phpcsstandards/phpcsextra"/>

    <rule ref="WordPress-Core">
        <!-- PHP 8.2 is the floor. WPCS forbids short arrays for PHP 5.3
             compatibility that stopped mattering years ago. -->
        <exclude name="Universal.Arrays.DisallowShortArraySyntax"/>
        <exclude name="WordPress.PHP.YodaConditions"/>

        <!-- Would split every multi-argument call across separate lines:
             longer and no clearer. -->
        <exclude name="PEAR.Functions.FunctionCallSignature"/>

        <!-- Short ternaries are used deliberately and read fine. -->
        <exclude name="Universal.Operators.DisallowShortTernary"/>

        <!-- Assignment alignment is already consistent; the sniff disagrees
             with itself across multi-line calls. -->
        <exclude name="Generic.Formatting.MultipleStatementAlignment"/>
        <exclude name="WordPress.Arrays.MultipleStatementAlignment"/>

        <!-- WordPress names files class-foo.php; PSR-4 autoloading requires
             Foo.php. This is a Composer library, so PSR-4 wins. -->
        <exclude name="WordPress.Files.FileName"/>

        <!-- Warns on parameters named $namespace, $object, $default. PHP does
             not reserve any of these, WordPress core uses $namespace itself,
             and renaming them would make the signatures worse to read. -->
        <exclude name="Universal.NamingConventions.NoReservedKeywordParameterNames"/>

        <!-- current_time( 'timestamp' ) is used deliberately and consistently.
             Ages and date ranges here are wall-clock arithmetic against the
             store's own day: an admin writing "orders today" means their today,
             not UTC's. The sniff's advice (use time(), format with wp_date())
             is right for display and wrong for the subtraction these helpers
             do. This is a design decision, not a formatting one, so it is
             stated here rather than repeated at six call sites. -->
        <exclude name="WordPress.DateTime.CurrentTimeTimestamp"/>
    </rule>

    <file>src</file>
    <arg name="extensions" value="php"/>
    <arg name="basepath" value="."/>
    <arg name="colors"/>
    <arg value="sp"/>
</ruleset>
